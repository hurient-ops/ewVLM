# ewVLM Backend Environment Variables

# Local VLM toggle.
# If "true", uses LM Studio running locally at localhost:1234
# If "false", uses Multi-Cloud API endpoints (Groq, Upstage, HuggingFace)
USE_LOCAL_VLM=false

# ---------------------------------------------------------
# Multi-Cloud VLM API Keys (Required if USE_LOCAL_VLM=false)
# ---------------------------------------------------------

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY="your_groq_api_key_here"

# Upstage API Key (https://console.upstage.ai/)
UPSTAGE_API_KEY="your_upstage_api_key_here"

# HuggingFace API Key (https://huggingface.co/settings/tokens)
HF_API_KEY="your_huggingface_api_key_here"

# ---------------------------------------------------------
# Other Configuration
# ---------------------------------------------------------
PORT=8000
